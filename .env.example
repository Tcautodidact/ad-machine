# Kopieer naar .env.local en vul in. Zonder Supabase draait het dashboard in demo-modus.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Jev / TypeSafe AI (https://typesafe.ai)
TYPESAFE_API_KEY=

# Meta Ad Library API (token van een geverifieerd Meta developer-account)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# Geheim token waarmee de dagelijkse jobs (/api/jobs/*) mogen draaien. Verzin een lange random string.
CRON_SECRET=
